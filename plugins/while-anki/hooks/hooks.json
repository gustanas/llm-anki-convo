{
  "description": "Open While Anki for the user's chosen messages and close its view when a turn ends.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\user-prompt-submit.mjs\"",
            "timeout": 3,
            "additionalContextLimit": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "show_anki_review$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/view-lifecycle.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\view-lifecycle.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/view-lifecycle.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\view-lifecycle.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/view-lifecycle.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\view-lifecycle.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
